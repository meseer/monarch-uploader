{
  "name": "monarch-uploader",
  "version": "8.0.2",
  "description": "Violentmonkey userscript for uploading Questrade, Wealthsimple, Canada Life, and Rogers Bank data to Monarch Money",
  "main": "dist/monarch-uploader.user.js",
  "scripts": {
    "build": "npm run clean && vite build --mode production",
    "build:dev": "vite build --mode development",
    "build:stable": "npm run clean && BUILD_TYPE=stable vite build --mode production",
    "build:dev-release": "npm run clean && BUILD_TYPE=dev vite build --mode production",
    "build:full": "npm run clean && npm run lint && npm run typecheck && npm run test && vite build --mode production",
    "watch": "vite build --mode development --watch",
    "watch:dev": "BUILD_TYPE=dev vite build --mode development --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "clean": "rm -rf dist/",
    "postbuild": "echo 'Build complete! Output in dist/'",
    "build:quick": "npm run clean && npm run build:dev",
    "typecheck": "tsc --noEmit",
    "version:bump": "node scripts/bump-version.cjs"
  },
  "keywords": [
    "violentmonkey",
    "userscript",
    "questrade",
    "wealthsimple",
    "canadalife",
    "rogersbank",
    "monarch-money"
  ],
  "author": "Mykhailo Delegan",
  "license": "CC-BY-NC-SA-4.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@types/tampermonkey": "^5.5.0",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-loader": "^10.0.0",
    "c8": "^12.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "terser": "^5.51.2",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3"
  },
  "overrides": {
    "rimraf": "^5.0.0",
    "glob": "^10.0.0",
    "inflight": "npm:@isaacs/inflight@^1.0.6"
  }
}
